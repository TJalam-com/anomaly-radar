# Copy to .env (gitignored). Local dev only - rotate before production.
# Dune key: set locally; rotate before production.
DUNE_API_KEY=
# Polygon RPC for funding tracer + resolution lookups. Must serve ARCHIVE data (Feb-2026 receipts + eth_getLogs).
# Measured 2026-09-26T09:06Z (results/D1_endpoint_census_2026-09-26_r2.md):
#   tenderly gateway : old receipt OK, eth_getLogs 2001-block window at block ~83.57M OK   <- default
#   quiknode public  : same as tenderly (fallback)
#   drpc free        : old receipt OK, historical eth_getLogs REFUSED ("ranges over 10000 blocks ... free plan")
#   publicnode       : old receipt returns null (pruned)  - do not use for history
#   polygon-rpc.com  : 403 tenant disabled; ankr: needs key; onfinality public: 429 after a few calls
# Rate limits of tenderly/quiknode public endpoints NOT measured. Keep getLogs windows <= 2000 blocks.
# QA ruling on census r2 (2026-09-26): tenderly default + quiknode fallback (supersedes earlier drpc ruling).
# Rate limit must be measured before bulk eth_getLogs.
POLYGON_RPC_URL=https://polygon.gateway.tenderly.co
POLYGON_RPC_FALLBACK_URL=https://rpc-mainnet.matic.quiknode.pro
# Optional: Etherscan V2 (chainid=137)
ETHERSCAN_API_KEY=
